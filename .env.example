# ---- LLM providers (set the keys for the providers you want to use) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=gemini            # openai | anthropic | gemini
OPENAI_MODEL=gpt-4o-mini       # check each provider's docs for current model names
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After fine-tuning, point this to models/embedding-ft to use the tuned model
# EMBEDDING_MODEL=models/embedding-ft

# ---- Vector store ----
VECTOR_BACKEND=faiss           # faiss | pinecone
INDEX_DIR=data/index
PINECONE_API_KEY=
PINECONE_INDEX=copilot-index
PINECONE_NAMESPACE=default

# ---- Chunking / retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ---- Multimodal models (downloaded on first use) ----
WHISPER_MODEL=openai/whisper-base
CAPTION_MODEL=Salesforce/blip-image-captioning-base
